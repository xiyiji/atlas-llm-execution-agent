# Atlas runs end-to-end without credentials in demo mode.
FORCE_DEMO=1
ATLAS_ENV=development
AUTH_REQUIRED=0
AUDIT_FILE_ENABLED=1
MEMORY_FILE_ENABLED=1
ATLAS_API_KEYS=
SESSION_SECRET=dev-only-change-me
SESSION_TTL_SECONDS=3600
APPROVAL_THRESHOLD=60
MAX_STEP_RETRIES=2
CODE_TIMEOUT_SECONDS=8
APPROVAL_TIMEOUT_SECONDS=600
MAX_REQUEST_BYTES=1000000
RATE_LIMIT_PER_MINUTE=120
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_ORIGINS=

# Persistence and distributed execution
DATABASE_URL=sqlite:///data/atlas.db
EXECUTION_BACKEND=inprocess
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Sandbox and retrieval limits
SANDBOX_BACKEND=local
SANDBOX_MEMORY_MB=128
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
WEB_MAX_RESPONSE_BYTES=2000000

# Optional live providers. Set FORCE_DEMO=0 and configure one provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
